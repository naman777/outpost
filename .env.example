# Postgres connection string (Neon: use the pooled URL, keep ?sslmode=require)
DATABASE_URL=""

# Public base URL the tracking pixel and click links point at. Must be reachable
# from the internet (your Vercel URL, ideally a custom domain like https://t.yourdomain.com).
APP_URL="http://localhost:3000"

# Password for the dashboard login (single user)
DASHBOARD_PASSWORD=""

# 32+ random characters. Signs the login cookie and encrypts stored SMTP passwords / OAuth tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=""

# Bearer key for the public API (/api/v1/*) used by scripts and other mail clients
API_KEY=""

# Bearer key Vercel Cron sends to /api/cron/sync
CRON_SECRET=""

# Optional: Google OAuth client for "Connect Gmail" (Gmail API send + reply sync)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Time zone used for "send hour" / weekday stats
APP_TIMEZONE="UTC"

# Optional: database connections per app instance (1-100). Lower this on serverless hosts.
DATABASE_POOL_MAX="5"
